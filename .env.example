# Copy to .env and edit as needed.
ARBYS_DB_URL=postgresql+asyncpg://arbys:arbys@localhost:5432/arbys

# Adapter feature flags
ARBYS_ENABLE_POLYMARKET=1
ARBYS_ENABLE_KALSHI=1
ARBYS_ENABLE_DRAFTKINGS=0

# Adapter credentials (only needed for live/authenticated endpoints)
# POLYMARKET_API_KEY=
# KALSHI_EMAIL=
# KALSHI_PASSWORD=
