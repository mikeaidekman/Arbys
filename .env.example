# Copy to .env and edit as needed.
#
# Local dev default = SQLite (no server required). File is gitignored.
ARBYS_DB_URL=sqlite+aiosqlite:///./arbys-local.db
# For a shared / production setup, use Postgres instead:
# ARBYS_DB_URL=postgresql+asyncpg://arbys:arbys@localhost:5432/arbys

# Adapter feature flags
# Master switch for live market data ingest. When 0 (default), the backend
# runs without connecting to any venue — quotes must be pushed via POST /quotes.
# Set to 1 in production to start Polymarket (WS) + Kalshi + optionally DK.
ARBYS_ENABLE_INGEST=0
ARBYS_ENABLE_POLYMARKET=1
ARBYS_ENABLE_KALSHI=1
ARBYS_ENABLE_DRAFTKINGS=0

# Auto-discovery: periodically scan Kalshi + Polymarket for cross-venue sports
# games (MLB for now) and auto-register matching event groups. Requires
# ARBYS_ENABLE_INGEST=1 to actually stream the discovered outcomes.
ARBYS_ENABLE_DISCOVERY=0
ARBYS_DISCOVERY_INTERVAL_S=600

# Adapter credentials (only needed for live/authenticated endpoints)
# POLYMARKET_API_KEY=
#
# Kalshi authenticated WebSocket (real-time streaming). When both are set the
# backend uses the WS adapter; otherwise it falls back to REST polling at 5s.
# Get these from https://kalshi.com/account/profile → API keys.
# The private key is the .pem file Kalshi asks you to save — keep it OUTSIDE
# this repo. Point KALSHI_PRIVATE_KEY_PATH at its absolute path.
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=
