# Copy to .env and edit as needed.
#
# Local dev default = SQLite (no server required). File is gitignored.
ARBYS_DB_URL=sqlite+aiosqlite:///./arbys-local.db
# For a shared / production setup, use Postgres instead:
# ARBYS_DB_URL=postgresql+asyncpg://arbys:arbys@localhost:5432/arbys

# Adapter feature flags
# Master switch for live market data ingest. When 0 (default), the backend
# runs without connecting to any venue — quotes must be pushed via POST /quotes.
# Set to 1 in production to start Polymarket US + Kalshi + optionally DK.
ARBYS_ENABLE_INGEST=0
# Only the DraftKings flag is actually read (adapters/draftkings.py); the
# Polymarket and Kalshi adapters are always built when ingest is on.
ARBYS_ENABLE_DRAFTKINGS=0

# Seconds between Polymarket US /bbo sweeps. Measured 2026-08-11: 53
# concurrent calls returned in 1.46s with no rate limiting, so 5s is
# comfortable. Values below 1s are clamped. This is the credential-less
# fallback path only — with POLYMARKET_US_API_KEY_ID set, the WebSocket is
# used instead and this is ignored.
ARBYS_POLYMARKET_US_POLL_S=5

# Markets per Polymarket US WebSocket connection. One connection silently
# stops streaming a large fraction of its markets past some ceiling: measured
# 2026-08-25, 573 slugs on one socket shed eight of nine slugs that were
# provably live, with no error and no disconnect — in-play legs simply aged to
# a 416s median while Kalshi's were at 0.3s. So the subscription is split
# across sockets, 100 markets each. Each shard logs `live N/M` every 30s;
# lower this if that count sags.
ARBYS_POLYMARKET_US_WS_SHARD_SIZE=100

# Socket silence before a subscribed Polymarket US market is treated as dark,
# and the far tighter deadline for one whose game is already under way.
#
# Dark is a diagnosis, not a data source. The adapter responds by re-sending a
# subscribe for that market, and by rebuilding the connection if that fails for
# a live game - never by fetching the price from somewhere else. A REST read
# lags the WebSocket ladder and carries no size at all, and a sizeless quote is
# worse than none: sizing treats unknown depth as *no ceiling*, so one produced
# a 200-contract ticket where legs built from real ladder depth were capped
# at 25.
ARBYS_POLYMARKET_US_DARK_AFTER_S=120
ARBYS_POLYMARKET_US_PRIORITY_DARK_AFTER_S=6

# Auto-discovery: periodically scan Kalshi + Polymarket US for cross-venue
# sports games (MLB, NFL, NBA, ATP/WTA tennis) and auto-register matching
# event groups. Requires ARBYS_ENABLE_INGEST=1 to actually stream the
# discovered outcomes.
ARBYS_ENABLE_DISCOVERY=0
ARBYS_DISCOVERY_INTERVAL_S=600

# Max open units per outcome for one paper account. An edge stays published
# while it exists, so without a cap repeat executions stack without bound —
# five clicks put on five times the intended size. A binary ticket buying N
# units pays off N, so this caps guaranteed-payoff exposure. 0 disables.
ARBYS_MAX_OUTCOME_QTY=500

# Max total capital in a single arb ticket, in dollars. Sizing is depth-driven,
# so without this one ticket could consume an entire book. 0 disables.
ARBYS_MAX_TICKET_STAKE=200

# Auto-trader: submit a paper ticket for every net-positive opportunity the
# engine publishes, without a human clicking Fill. 0 by default — it trades
# (on paper) the moment it is on.
#
# The trigger is the honest net-of-fees gate, identical to what the Fill button
# accepts. There is no gross-edge mode and no configurable edge floor. Measured
# 2026-08-27, 5 of 496 groups had a net-positive pair worth ~18c in total, three
# of them sized at 0.01-0.03 contracts against off-market dust orders. A near-
# empty ticket log is the bot working correctly, and is not a reason to loosen
# the gate.
#
# No real venue can be reached: PaperExecutionAdapter is the only
# ExecutionAdapter in the repo and paper fills are atomic, so the bot cannot
# end up holding one naked leg.
ARBYS_ENABLE_AUTO_TRADE=0

# Seconds a group is ignored after the auto-trader *fills* it. An edge stays
# published while it exists, so without this one edge becomes a burst of
# tickets until the position cap stops it. Rejects and misses do not start a
# cooldown — a miss means the edge was gone, which is no reason to stop
# watching the group. 0 disables.
ARBYS_AUTO_TRADE_COOLDOWN_S=60

# Adapter credentials (only needed for live/authenticated endpoints)
#
# Polymarket US market data comes from the PUBLIC gateway
# (gateway.polymarket.us) and needs no credentials at all. The authenticated
# host (api.polymarket.us) is required only for order placement and the market
# WebSocket, both of which need completed KYC plus an Ed25519 key pair.
# Neither is wired yet — these are placeholders for when the WS adapter lands.
# As with the Kalshi key, keep any private key OUTSIDE this repo.
# POLYMARKET_US_API_KEY_ID=
# POLYMARKET_US_PRIVATE_KEY_PATH=
#
# Kalshi authenticated WebSocket (real-time streaming). When both are set the
# backend uses the WS adapter; otherwise it falls back to REST polling at 5s.
# Get these from https://kalshi.com/account/profile → API keys.
# The private key is the .pem file Kalshi asks you to save — keep it OUTSIDE
# this repo. Point KALSHI_PRIVATE_KEY_PATH at its absolute path.
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=

# How old a quote may be before it stops counting as tradeable. Venue
# websockets push only on change, so without this a dead feed looks identical
# to a quiet market and its last price quotes forever. 0 disables expiry.
ARBYS_QUOTE_MAX_AGE_S=600
