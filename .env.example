# Copy to .env and edit as needed.
#
# Local dev default = SQLite (no server required). File is gitignored.
ARBYS_DB_URL=sqlite+aiosqlite:///./arbys-local.db
# For a shared / production setup, use Postgres instead:
# ARBYS_DB_URL=postgresql+asyncpg://arbys:arbys@localhost:5432/arbys

# Adapter feature flags
# Master switch for live market data ingest. When 0 (default), the backend
# runs without connecting to any venue — quotes must be pushed via POST /quotes.
# Set to 1 in production to start Polymarket US + Kalshi + optionally DK.
ARBYS_ENABLE_INGEST=0
# Only the DraftKings flag is actually read (adapters/draftkings.py); the
# Polymarket and Kalshi adapters are always built when ingest is on.
ARBYS_ENABLE_DRAFTKINGS=0

# Seconds between Polymarket US /bbo sweeps. Measured 2026-08-11: 53
# concurrent calls returned in 1.46s with no rate limiting, so 5s is
# comfortable. Values below 1s are clamped. This is the credential-less
# fallback path only — with POLYMARKET_US_API_KEY_ID set, the WebSocket is
# used instead and this is ignored.
ARBYS_POLYMARKET_US_POLL_S=5

# Markets per Polymarket US WebSocket connection. One connection silently
# stops streaming a large fraction of its markets past some ceiling: measured
# 2026-08-25, 573 slugs on one socket shed eight of nine slugs that were
# provably live, with no error and no disconnect — in-play legs simply aged to
# a 416s median while Kalshi's were at 0.3s. So the subscription is split
# across sockets, 100 markets each. Each shard logs `live N/M` every 30s;
# lower this if that count sags.
ARBYS_POLYMARKET_US_WS_SHARD_SIZE=100

# Socket silence before a subscribed Polymarket US market is treated as dark,
# and the far tighter deadline for one whose game is already under way.
#
# Dark is a diagnosis, not a data source. The adapter responds by re-sending a
# subscribe for that market, and by rebuilding the connection if that fails for
# a live game - never by fetching the price from somewhere else. A REST read
# lags the WebSocket ladder and carries no size at all, and a sizeless quote is
# worse than none: sizing treats unknown depth as *no ceiling*, so one produced
# a 200-contract ticket where legs built from real ladder depth were capped
# at 25.
ARBYS_POLYMARKET_US_DARK_AFTER_S=120
ARBYS_POLYMARKET_US_PRIORITY_DARK_AFTER_S=6

# Auto-discovery: periodically scan Kalshi + Polymarket US for cross-venue
# sports games (MLB, NFL, NBA, ATP/WTA tennis) and auto-register matching
# event groups. Requires ARBYS_ENABLE_INGEST=1 to actually stream the
# discovered outcomes.
ARBYS_ENABLE_DISCOVERY=0
ARBYS_DISCOVERY_INTERVAL_S=600

# Max capital committed to one event group, in dollars of cost basis. The
# only CUMULATIVE cap: ARBYS_MAX_TICKET_STAKE bounds a single ticket (the
# legging control, since a ticket is what can half-fill) and says nothing
# about how many tickets pile onto the same game. An edge stays published
# while it exists, so without this one fixture can absorb the bankroll.
# Counted across every leg of the group, both venues together. 0 disables.
ARBYS_MAX_OUTCOME_STAKE=500

# Max total capital in a single arb ticket, in dollars. Sizing is depth-driven,
# so without this one ticket could consume an entire book. 0 disables.
ARBYS_MAX_TICKET_STAKE=250

# Smallest ticket worth taking, in contracts. A floor on SIZE, not on edge —
# a fat per-contract edge on two contracts is still refused. Contracts are
# fractional on both venues, so a thin book yields tickets worth fractions of
# a cent that still carry a full position's bookkeeping, and a dust fill
# starts the same auto-trade cooldown as a real one. 0 disables.
ARBYS_MIN_CONTRACT_QTY=5

# Auto-trader: submit a paper ticket for every net-positive opportunity the
# engine publishes, without a human clicking Fill. 0 by default — it trades
# (on paper) the moment it is on.
#
# The trigger is the honest net-of-fees gate, identical to what the Fill button
# accepts. There is no gross-edge mode and no configurable edge floor. Measured
# 2026-08-27, 5 of 496 groups had a net-positive pair worth ~18c in total, three
# of them sized at 0.01-0.03 contracts against off-market dust orders. A near-
# empty ticket log is the bot working correctly, and is not a reason to loosen
# the gate.
#
# No real venue can be reached: PaperExecutionAdapter is the only
# ExecutionAdapter in the repo and paper fills are atomic, so the bot cannot
# end up holding one naked leg.
ARBYS_ENABLE_AUTO_TRADE=0

# Seconds a group is ignored after the auto-trader *fills* it. An edge stays
# published while it exists, so without this one edge becomes a burst of
# tickets until the position cap stops it. Rejects and misses do not start a
# cooldown — a miss means the edge was gone, which is no reason to stop
# watching the group. 0 disables.
ARBYS_AUTO_TRADE_COOLDOWN_S=60

# Seconds before another *non-fill* on the same group is written to the ticket
# log. The attempt still runs at full rate — a vanished edge is no reason to
# stop watching — so this suppresses only the duplicate audit row. Without it
# a live book, whose published `qty` moves on nearly every depth tick,
# republished the same dying edge over and over: 1,149 missed tickets
# describing 116 distinct groups on 2026-08-27, 74% of the repeats landing in
# the same second, which read out as a 16% per-ticket fill rate against a 94%
# per-group one. Nothing counts the suppressed attempts and that is deliberate
# — every published opportunity is already persisted to `arb_opportunity`, so
# attempt volume stays recoverable from that tape. 0 records every attempt.
ARBYS_AUTO_TRADE_NONFILL_LOG_S=60

# Whether the whole system pairs legs across venues only. On by default.
#
# Governs three things that have to agree, or the screen and the engine
# describe different edges: the engine skips detect_complementary_set entirely
# (so nothing intra-venue reaches /opportunities or the arb_opportunity tape),
# /monitored's pair search skips same-venue candidates, and the auto-trader
# refuses a same-venue ticket as a last line of defence.
# detect_cross_venue_two_leg enforces it unconditionally at any setting — its
# name says cross-venue and it has no business emitting a complementary pair.
#
# A same-venue edge is one book crossed against itself, which someone
# co-located takes in milliseconds. Measured 2026-08-27: 5 fills of 244
# attempts worth $0.41, against 537 of 1,149 missed tickets and half the
# forgone edge — and the large ones were not arbitrage at all but one-sided
# stale quotes (Kalshi quoting LAR:YES at 0.87 beside LAC:YES at 0.05).
#
# It also fixes a display bias. 42.7% of head-to-head ask comparisons between
# the two venues are exact price ties, and Polymarket US wins every one of
# them on fees alone (0.06 vs Kalshi's 0.07 coefficient), so 47.9% of groups
# were being described by a Polymarket-versus-itself pair and Kalshi looked
# absent from the book when its feed was in fact the healthier of the two.
#
# Set to 0 to detect and trade same-venue edges again.
ARBYS_CROSS_VENUE_ONLY=1

# Adapter credentials (only needed for live/authenticated endpoints)
#
# Polymarket US market data comes from the PUBLIC gateway
# (gateway.polymarket.us) and needs no credentials at all. The authenticated
# host (api.polymarket.us) is required only for order placement and the market
# WebSocket, both of which need completed KYC plus an Ed25519 key pair.
# Neither is wired yet — these are placeholders for when the WS adapter lands.
# As with the Kalshi key, keep any private key OUTSIDE this repo.
# POLYMARKET_US_API_KEY_ID=
# POLYMARKET_US_PRIVATE_KEY_PATH=
# POLYMARKET_US_PRIVATE_KEY= # inline base64 secret; wins over _PATH
#
# Each venue takes its key EITHER inline (`*_PRIVATE_KEY`) or as a file path
# (`*_PRIVATE_KEY_PATH`). Inline wins when both are set.
#
# The path form is right on a laptop: it keeps the key outside this repo, where
# a .env eventually reaches git. A container has no repo, no .env and no file,
# and the platform secret store IS that outside-the-repo location — hence the
# inline form. Kalshi's PEM is multi-line; a store or shell that flattens it to
# literal 
 sequences is handled, so paste it either way.
#
# Absent is a configuration; broken is a bug. With neither variable set the
# backend uses the documented no-KYC REST path. With an ID set and the key
# missing or malformed it now REFUSES TO START, rather than downgrading
# silently to REST — the hosting design rests on the credentialed WebSocket
# refilling the book in seconds after a restart, and a silent downgrade leaves
# that premise broken while the app still reports healthy. `/health` reports
# the resolved path per venue so it is checkable from outside.

# Kalshi authenticated WebSocket (real-time streaming). When both are set the
# backend uses the WS adapter; otherwise it falls back to REST polling at 5s.
# Get these from https://kalshi.com/account/profile → API keys.
# The private key is the .pem file Kalshi asks you to save — keep it OUTSIDE
# this repo. Point KALSHI_PRIVATE_KEY_PATH at its absolute path.
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=
# KALSHI_PRIVATE_KEY=        # inline PEM; wins over _PATH

# How old a quote may be before it stops counting as tradeable. Venue
# websockets push only on change, so without this a dead feed looks identical
# to a quiet market and its last price quotes forever. 0 disables expiry.
ARBYS_QUOTE_MAX_AGE_S=600

# How far apart two legs' quote ages may be before a ticket is refused. An
# arbitrage is a claim that two venues disagree *right now*; if one leg arrived
# seconds ago and the other is minutes old, the "divergence" may just be the
# market having moved while one feed was not answering — and the paper broker
# fills against the stale price as happily as the live one.
#
# Measured over 2026-08-27: 23 of 260 auto fills (8.8%) had one leg stale and
# one live, and those 23 carried $34.55 of the day's $97.71 expected profit —
# 35%. The clearest was atp-BONZI-ZANDSCHULP, where our Polymarket leg sat
# pinned at 0.86 for seven minutes while Kalshi ran 0.15 -> 0.02 toward
# resolution; it produced the single richest fill of the day and five more.
#
# 30 is not a guess: the observed skew on real fills is bimodal, running
# 0, 1, 2, 4, 22, 28 seconds and then nothing at all until 36.
#
# Skew, not absolute age, is the signal — two legs both quiet for ten minutes
# are a pre-game market whose price genuinely has not moved (28 such fills,
# $1.63 between them). ARBYS_QUOTE_MAX_AGE_S above handles everything being
# too old. 0 disables the gate.
ARBYS_MAX_LEG_AGE_SKEW_S=30

# --- Cloudflare Access -----------------------------------------------------
#
# This app has NO authentication of its own, and POST /quotes lets a caller
# inject arbitrary prices (so, manufacture an arbitrage) while
# POST /paper/{id}/reset wipes the ledger. On a laptop that is survivable
# because nothing can reach it. On a platform the hostname is public by
# construction.
#
# Set BOTH or neither. With either unset this is a no-op, so local dev and the
# test suite are unaffected — and a half-configured deploy behaves like an
# unprotected one, which is loud rather than subtly weak.
#
# The assertion is VERIFIED, not merely fronted: a direct request to
# <app>.fly.dev carries no signed assertion and is refused, so the origin is
# not quietly reachable around Access. /health is exempt, because Fly's own
# checks reach the machine internally and cannot present one.
#
# CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# CF_ACCESS_AUD=<the Access application's Audience tag>
